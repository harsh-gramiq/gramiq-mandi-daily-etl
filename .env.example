# ==============================================================================
# 🌾 GramIQ Mandi ETL Environment Configuration
# ==============================================================================

# Option A: Direct PostgreSQL URI
DATABASE_URL=postgresql://postgres:password@localhost:5432/gramiq_production

# Option B: Individual PostgreSQL Parameters
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=gramiq_production
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password
